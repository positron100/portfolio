# Contact form. Copy to `.env` and fill in; `.env` is git-ignored.
#
# Resend API key. Server-side only: it is read by api/contact.ts and never
# reaches the browser bundle. Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Where contact form messages are delivered.
CONTACT_EMAIL=mukuknegi2005@gmail.com

# The verified sender the mail is actually sent as. Must be an address on a
# domain verified with the provider. The visitor's own address cannot go here
# (SPF/DKIM would fail); it is set as Reply-To instead, so replying reaches
# them directly. Resend's shared sender works for testing:
EMAIL_FROM=Portfolio <onboarding@resend.dev>
